    {name:"GIAN",values:[68,250,0,60,68,100]},
    {name:"KEVIN",values:[45,99,15,0,45,0]}
  ];
  const summaryData = [
    {category:"GOING TO SCHOOL",people:"6/8",frequency:"18%",total:470,average:"₱58.75",priority:"NEEDS",respondents:"1/8",priorityPct:"12.50%"},
    {category:"FOODS",people:"8/8",frequency:"50%",total:1312,average:"₱164.00",priority:"NEEDS",respondents:"7/8",priorityPct:"87.50%"},
    {category:"GOING HOME",people:"7/8",frequency:"13.96%",total:363,average:"₱45.38",priority:"NEEDS",respondents:"3/8",priorityPct:"37.50%"},
    {category:"WATER/DRINKS",people:"4/8",frequency:"5%",total:130,average:"₱16.25",priority:"NEEDS",respondents:"2/8",priorityPct:"25%"},
    {category:"AFTER CLASS GALA",people:"2/8",frequency:"5%",total:120,average:"₱15.00",priority:"WANTS",respondents:"2/8",priorityPct:"25%"},
    {category:"SCHOOL MATERIALS",people:"2/8",frequency:"8%",total:200,average:"₱25.00",priority:"NEEDS",respondents:"2/8",priorityPct:"25%"}
  ];
  let balance = START_BUDGET, totalSpent = 0, bonusTotal = 0, transactions = [], soundOn = true, lastRoll = [1,1], reportMode = "summary", audioCtx;
  const $ = id => document.getElementById(id);
  const money = n => "₱" + Number(n).toLocaleString("en-PH",{maximumFractionDigits:2});
  const escapeHTML = s => String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  function fillPlayers(){
    ["playerSelect","expensePlayer"].forEach(id=>{ $(id).innerHTML=people.map(p=>`<option>${p}</option>`).join(""); });
  }
  function playTone(type="coin"){
    if(!soundOn) return;
    try{
      audioCtx = audioCtx || new (window.AudioContext||window.webkitAudioContext)();
      if(audioCtx.state==="suspended") audioCtx.resume();
      const now=audioCtx.currentTime;
      const notes= type==="win" ? [523,659,784,1046] : type==="bonus" ? [660,880,990] : type==="dice" ? [240,320] : [620,820];
      notes.forEach((freq,i)=>{
        const osc=audioCtx.createOscillator(), gain=audioCtx.createGain();
        osc.type=type==="expense"?"triangle":"sine"; osc.frequency.setValueAtTime(freq,now+i*.09);
        gain.gain.setValueAtTime(.0001,now+i*.09);gain.gain.exponentialRampToValueAtTime(.12,now+i*.09+.02);gain.gain.exponentialRampToValueAtTime(.0001,now+i*.09+.16);
        osc.connect(gain);gain.connect(audioCtx.destination);osc.start(now+i*.09);osc.stop(now+i*.09+.18);
      });
    }catch(e){}
  }
  function toast(msg){const el=$("toast");el.textContent=msg;el.classList.add("show");clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.classList.remove("show"),2500);}
  function confetti(){
    const shapes=["■","●","✦","◆"];
    for(let i=0;i<70;i++){
      const el=document.createElement("div");el.className="confetti";el.textContent=shapes[Math.floor(Math.random()*shapes.length)];
      el.style.left=Math.random()*100+"vw";el.style.color=["#e7b844","#e05d4d","#2c8757","#568ac1","#a477c2"][Math.floor(Math.random()*5)];
      el.style.fontSize=(9+Math.random()*10)+"px";el.style.animationDelay=(Math.random()*.7)+"s";el.style.animationDuration=(1.7+Math.random()*1.6)+"s";
      document.body.appendChild(el);setTimeout(()=>el.remove(),4000);
    }
  }
  function updateStats(){
    $("balance").textContent=money(balance);$("spent").textContent=money(totalSpent);
    $("transactionCount").textContent=transactions.length;$("usedPercent").textContent=Math.round(totalSpent/START_BUDGET*100)+"%";
    $("ledgerPill").textContent=transactions.length+" entr"+(transactions.length===1?"y":"ies");
  }
  function renderLedger(){
    const el=$("ledger");
    if(!transactions.length){el.innerHTML='<div class="empty">No expenses revealed yet.<br>Record a transaction to see it appear here.</div>';return;}
    el.innerHTML=[...transactions].reverse().map(t=>`<div class="ledger-item ${t.type==="bonus"?"bonus":""}">
      <div><div class="who">${t.type==="bonus"?"🎁 "+escapeHTML(t.person)+" · TREASURE CHEST":(categoryIcons[t.category]||"💸")+" "+escapeHTML(t.person)}</div>
      <div class="detail">${escapeHTML(t.category)}${t.note?" · "+escapeHTML(t.note):""} · ${escapeHTML(t.time)}</div></div>
      <div class="amt">${t.type==="bonus"?"+":"−"}${money(t.amount)}</div>
    </div>`).join("");
  }
  function reveal({icon="💸",eyebrow="Expense revealed",title,amount,description,bonus=false}){
    $("modalIcon").textContent=icon;$("modalEyebrow").textContent=eyebrow;$("modalTitle").textContent=title;
    $("modalAmount").textContent=(bonus?"+":"−")+money(amount);
    $("modalAmount").style.color=bonus?"#247b4c":"var(--red)";
    $("modalDescription").textContent=description;$("modalBackdrop").classList.add("show");
  }
  function deduct(){
    const person=$("expensePlayer").value, category=$("expenseCategory").value, raw=$("expenseAmount").value, amount=Number(raw), note=$("expenseNote").value.trim();
    if(raw===""||!Number.isFinite(amount)||amount<0){toast("Enter a valid expense amount.");return;}
    if(amount>balance){toast("Not enough money in the shared budget!");playTone("expense");return;}
    if(amount===0){toast("₱0 recorded — no money deducted.");}
    balance-=amount;totalSpent+=amount;
    transactions.push({type:"expense",person,category,amount,note,time:new Date().toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"})});
    updateStats();renderLedger();playTone("expense");
    reveal({icon:categoryIcons[category]||"💸",title:category,amount,description:`${person} spent ${money(amount)} on ${category.toLowerCase()}.${note?" Note: "+note:""} ${money(balance)} remains in the shared wallet.`});
    $("expenseAmount").value="";$("expenseNote").value="";
    if(balance===0){confetti();toast("The shared budget has reached ₱0!");}
  }
  function addBonus(){
    const raw=$("bonusAmount").value, amount=Number(raw), person=$("expensePlayer").value;
    if(raw===""||!Number.isFinite(amount)||amount<=0){toast("Enter a bonus greater than ₱0.");return;}
    balance+=amount;bonusTotal+=amount;
    transactions.push({type:"bonus",person,category:"TREASURE CHEST",amount,note:"Bonus added to shared wallet",time:new Date().toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"})});
    updateStats();renderLedger();playTone("bonus");confetti();
    reveal({icon:"🎁",eyebrow:"Treasure Chest bonus",title:"BONUS UNLOCKED!",amount,bonus:true,description:`${person} found a bonus of ${money(amount)}! The shared budget is now ${money(balance)}.`});
    $("bonusAmount").value="";
  }
  const diceFaces=["⚀","⚁","⚂","⚃","⚄","⚅"];
  function rollDice(){
    lastRoll=[1+Math.floor(Math.random()*6),1+Math.floor(Math.random()*6)];
    $("die1").textContent=diceFaces[lastRoll[0]-1];$("die2").textContent=diceFaces[lastRoll[1]-1];
    $("rollTotal").textContent=`Rolled ${lastRoll[0]} + ${lastRoll[1]} = ${lastRoll[0]+lastRoll[1]}`;
    playTone("dice");toast(`${$("playerSelect").value} rolled ${lastRoll[0]+lastRoll[1]}!`);
  }
  function useSpace(){
    const selected=$("landSelect").value;
    document.querySelectorAll(".tile").forEach(t=>t.classList.toggle("active",t.dataset.category===selected));
    if(categories.includes(selected)){
      $("expensePlayer").value=$("playerSelect").value;$("expenseCategory").value=selected;
      $("recordPanel").scrollIntoView({behavior:"smooth",block:"center"});
      $("expenseAmount").focus();toast(`${selected}: complete your challenge, reveal the card, then enter the amount.`);
    }else if(selected==="TREASURE CHEST"){
      $("expensePlayer").value=$("playerSelect").value;$("bonusAmount").focus();toast("Treasure Chest! Draw a card and enter the bonus amount.");
    }else if(selected==="STEP BACK"){
      toast("Step Back! Move your token backward on the physical board.");
    }else{
      confetti();playTone("win");toast("Finish reached! Check the remaining budget.");
    }
  }
  function renderReport(mode){
    reportMode=mode;
    if(mode==="people"){
      const head=`<thead><tr><th>Person</th>${categories.map(c=>`<th>${escapeHTML(c)}</th>`).join("")}<th>Total</th></tr></thead>`;
      const rows=personData.map(p=>`<tr><td><strong>${p.name}</strong></td>${p.values.map(v=>`<td>${money(v)}</td>`).join("")}<td><strong>${money(p.values.reduce((a,b)=>a+b,0))}</strong></td></tr>`).join("");
      const totals=categories.map((c,i)=>personData.reduce((s,p)=>s+p.values[i],0));
      $("reportTable").innerHTML=`<table>${head}<tbody>${rows}</tbody><tfoot><tr><td>TOTAL</td>${totals.map(v=>`<td>${money(v)}</td>`).join("")}<td>${money(totals.reduce((a,b)=>a+b,0))}</td></tr></tfoot></table>`;
    }else{
      const rows=summaryData.map(d=>`<tr><td><strong>${d.category}</strong></td><td>${d.people}</td><td>${d.frequency}</td><td>${money(d.total)}</td><td>${d.average}</td><td>${d.priority}</td><td>${d.respondents}</td><td>${d.priorityPct}</td></tr>`).join("");
      $("reportTable").innerHTML=`<table><thead><tr><th>Most common expenses / Category</th><th>No. of person</th><th>Percentage</th><th>Total expenses</th><th>Average amount spent</th><th>Spending priority</th><th>Number of respondents</th><th>Priority percentage</th></tr></thead><tbody>${rows}</tbody><tfoot><tr><td>TOTAL</td><td>—</td><td>99.96%*</td><td>${money(2595)}</td><td>${money(324.38)}</td><td>—</td><td>—</td><td>—</td></tr></tfoot></table><p class="small-muted" style="padding:8px 3px">*Values are shown as supplied in your table. Some source percentages / counts may not add up exactly due to rounding or the original survey calculations.</p>`;
    }
  }
  function exportCSV(){
    const rows=[["Type","Person","Category","Amount (PHP)","Note","Time"],...transactions.map(t=>[t.type,t.person,t.category,t.amount,t.note,t.time])];
    const csv=rows.map(r=>r.map(v=>`"${String(v??"").replace(/"/g,'""')}"`).join(",")).join("\r\n");
    const blob=new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8;"}),url=URL.createObjectURL(blob),a=document.createElement("a");
    a.href=url;a.download="money-moves-transactions.csv";a.click();URL.revokeObjectURL(url);toast("Transaction CSV exported.");
  }
  function resetGame(){
    if(!confirm("Reset the game and clear all live transactions?"))return;
    balance=START_BUDGET;totalSpent=0;bonusTotal=0;transactions=[];updateStats();renderLedger();
    document.querySelectorAll(".tile").forEach(t=>t.classList.remove("active"));
    $("die1").textContent="⚀";$("die2").textContent="⚀";$("rollTotal").textContent="Ready to roll";
    toast("Game reset. Shared budget restored to ₱2,600.");
  }
  fillPlayers();updateStats();renderLedger();renderReport("summary");
  $("deductBtn").addEventListener("click",deduct);$("bonusBtn").addEventListener("click",addBonus);
  $("rollBtn").addEventListener("click",rollDice);$("landBtn").addEventListener("click",useSpace);
  $("modalClose").addEventListener("click",()=>$("modalBackdrop").classList.remove("show"));
  $("modalBackdrop").addEventListener("click",e=>{if(e.target===$("modalBackdrop"))$("modalBackdrop").classList.remove("show");});
  $("resetBtn").addEventListener("click",resetGame);$("exportBtn").addEventListener("click",exportCSV);
  $("showSummaryBtn").addEventListener("click",()=>renderReport("summary"));$("showPeopleBtn").addEventListener("click",()=>renderReport("people"));
  $("soundToggle").addEventListener("click",()=>{soundOn=!soundOn;$("soundToggle").textContent=soundOn?"🔊 Sound on":"🔇 Sound off";if(soundOn)playTone("coin");});
})();
</script>
</body>
</html>
'''
path = Path("/mnt/data/money_moves_monopoly.html")
path.write_text(html, encoding="utf-8")
print(f"Created {path} ({path.stat().st_size:,} bytes)")
