(() => {
  const START_BUDGET = 2600;
  const people = ["CLARK","ZED","KIM","CJ","SHER","ANDREA","GIAN","KEVIN"];
  const categories = ["GOING TO SCHOOL","FOODS","WATER/DRINKS","AFTER CLASS GALA","GOING HOME","SCHOOL MATERIALS"];
  const categoryIcons = {"GOING TO SCHOOL":"🚌","FOODS":"🍱","WATER/DRINKS":"🥤","AFTER CLASS GALA":"🎡","GOING HOME":"🏠","SCHOOL MATERIALS":"✏️","TREASURE CHEST":"🧰","STEP BACK":"↩️","FINISH":"🏁"};
